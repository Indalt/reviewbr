{
  "id": "scoping-prisma-scr",
  "name": "Revisão de Escopo (PRISMA-ScR)",
  "review_type": "Scoping",
  "description": "Revisão de escopo (scoping review) sob PRISMA-ScR. Mapeia a amplitude/estado da arte de um tema exploratório. Não avalia risco de viés nem faz meta-análise; usa framework PCC (População-Conceito-Contexto). Mantém rastreabilidade PRISMA-S da busca.",
  "extends": "prisma-sr",
  "spec": "spec.md",
  "protocol_template": "protocol_template.md",
  "flow_template": "../prisma-sr/prisma_flow.template.json",
  "extraction_template": "../prisma-sr/study_characteristics_table.template.csv",

  "question_frameworks": ["PCC"],
  "default_question_framework": "PCC",

  "phases": {
    "F0": { "name": "Pré-registro", "active": true, "requires_registration": false },
    "F1": { "name": "Protocolo da questão (PCC)", "active": true },
    "F2": { "name": "Busca (PRISMA-S)", "active": true },
    "F3": { "name": "Deduplicação", "active": true },
    "F4": { "name": "Triagem TA + full-text", "active": true },
    "F5": { "name": "Extração / charting", "active": true },
    "F5_5": { "name": "Leitura/RAG orientada a objetivo", "active": true },
    "F6": { "name": "Risco de viés", "active": false, "note": "Não se aplica a scoping (PRISMA-ScR não exige avaliação de qualidade)" },
    "F7": { "name": "Síntese", "active": true, "allow_meta_analysis": false, "note": "Síntese descritiva/narrativa; sem pooling quantitativo" },
    "F8": { "name": "Resultados e manuscrito", "active": true }
  },

  "invariants_always_on": ["RV-01", "RV-02", "RV-03", "RV-04", "RV-05", "RV-06", "RV-07", "RV-08"],

  "gates": [
    { "phase": "F1", "rule": "RV-01", "tool": "submit_protocol_for_approval", "blocks": "spawn do librarian se protocolo não estiver [LOCKED]" },
    { "phase": "F4", "rule": "RV-02", "tool": "compute_flow_counts", "blocks": "contagens manuais" },
    { "phase": "F8", "rule": "RV-05", "tool": "validate_prisma_flow", "blocks": "export se o funil não fechar" },
    { "phase": "F8", "rule": "RV-08", "tool": "audit_methodology", "blocks": "síntese se estudo sem origem" }
  ],

  "required_supplements": [
    "prisma_scr_checklist_filled.md",
    "prisma_s_checklist_filled.md",
    "supplement_search_prisma_s.md",
    "supplement_sources_registry.md",
    "dedupe_report.md",
    "screening_report.md",
    "study_characteristics_table.csv",
    "prisma_flow_counts.md",
    "manuscript_prisma_revised.md",
    "change_log.md",
    "audit_summary.md"
  ],

  "project_folders": ["01_raw", "02_deduplicated", "03_screening", "03_screening/pdfs", "04_extraction", "05_synthesis", "logs", "rag"]
}
