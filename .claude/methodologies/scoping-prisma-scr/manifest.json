{
  "id": "scoping-prisma-scr",
  "name": "Revisão de Escopo (PRISMA-ScR)",
  "review_type": "Scoping",
  "serves_research_types": [
    "scoping_review"
  ],
  "description": "Revisão de escopo (scoping review) sob PRISMA-ScR. Mapeia a amplitude/estado da arte de um tema exploratório. Não avalia risco de viés nem faz meta-análise; usa framework PCC (População-Conceito-Contexto). Mantém rastreabilidade PRISMA-S da busca.",
  "extends": "prisma-sr",
  "spec": "spec.md",
  "protocol_template": "protocol_template.md",
  "flow_template": "../prisma-sr/prisma_flow.template.json",
  "extraction_template": "../prisma-sr/study_characteristics_table.template.csv",
  "_conformance_note": "A ÂNCORA da metodologia, como dado e não como prosa (DEBT-047). Dois padrões porque a própria descrição acima declara os dois: PRISMA-ScR governa o relato da revisão de escopo, e a rastreabilidade PRISMA-S da busca é mantida. Declarado explicitamente, e não herdado por `extends`, porque o conjunto difere do pai — o PRISMA 2020 não se aplica aqui.",
  "conformance": {
    "standards": [
      "prisma-scr",
      "prisma-s"
    ]
  },
  "condicoes": [
    {
      "id": "avaliacao_critica",
      "pergunta": "A revisão vai fazer avaliação crítica das fontes de evidência incluídas (qualidade metodológica ou risco de viés de cada fonte)?",
      "etapa": "F1",
      "opcoes": [
        "sim",
        "não"
      ],
      "note": "PRISMA-ScR, itens 12 e 16 ('If done'): no escopo a avaliação crítica é opcional, e os dois itens só se aplicam quando ela é feita. Fazer ou não é método, decidido a priori no protocolo (RV-01): por isso a pergunta é da F1, e não da F5 — seria decidir depois de ver os dados — nem da F6, desligada neste método. Com 'não', os itens 12 e 16 saem do denominador. Com 'sim', ficam [NÃO COBERTO]: a trilha do escopo não tem onde registrar a avaliação (a F6 está desligada e nenhum subitem a coleta); onde registrá-la é do DEBT-151. Decisão do pesquisador de 17/10/2026: 'o método declara a condição, o projeto responde' (DEBT-142; DEBT-150)."
    }
  ],
  "question_frameworks": [
    "PCC"
  ],
  "default_question_framework": "PCC",
  "phases": [
    {
      "id": "F0",
      "name": "Pré-registro",
      "role": "designer",
      "closes_with": "protocol.md",
      "producer_tools": [
        "plan_research_protocol"
      ],
      "active": true,
      "requires_registration": false
    },
    {
      "id": "F1",
      "name": "Protocolo da questão (PCC)",
      "role": "designer",
      "closes_with": "protocol.md",
      "producer_tools": [
        "submit_protocol_for_approval"
      ],
      "active": true
    },
    {
      "id": "F2",
      "name": "Busca (PRISMA-S)",
      "role": "librarian",
      "closes_with": "01_raw/",
      "producer_tools": [
        "search_openalex",
        "search_pubmed",
        "search_crossref",
        "search_core",
        "search_europe_pmc",
        "search_scielo",
        "search_semanticscholar",
        "search_papers_optimized",
        "search_repository",
        "import_dataset_ris",
        "import_bvs_export"
      ],
      "active": true
    },
    {
      "id": "F3",
      "name": "Deduplicação",
      "role": "screener",
      "closes_with": "02_deduplicated/dataset.json",
      "producer_tools": [
        "deduplicate_dataset"
      ],
      "active": true
    },
    {
      "id": "F4",
      "name": "Triagem TA + full-text",
      "role": "screener",
      "closes_with": "03_screening/included.json",
      "produces": [
        "03_screening/included_ta.json",
        "03_screening/excluded_ta.json",
        "03_screening/excluded_fulltext.json"
      ],
      "producer_tools": [
        "screen_candidates"
      ],
      "active": true
    },
    {
      "id": "F5",
      "name": "Extração / charting",
      "role": "extractor",
      "closes_with": "04_extraction/study_characteristics_table.csv",
      "producer_tools": [],
      "active": true
    },
    {
      "id": "F5_5",
      "name": "Leitura/RAG orientada a objetivo",
      "role": "reader",
      "closes_with": "04_extraction/evidence_synthesis.md",
      "produces": [
        "rag/index.json"
      ],
      "producer_tools": [],
      "active": true
    },
    {
      "id": "F6",
      "name": "Risco de viés",
      "active": false,
      "note": "Não se aplica a scoping (PRISMA-ScR não exige avaliação de qualidade)"
    },
    {
      "id": "F7",
      "name": "Síntese",
      "role": "analyst",
      "closes_with": "[NÃO DEFINIDO] a trilha não nomeia o arquivo da síntese; ela entra no manuscrito (F8)",
      "producer_tools": [],
      "active": true,
      "allow_meta_analysis": false,
      "note": "Síntese descritiva/narrativa; sem pooling quantitativo"
    },
    {
      "id": "F8",
      "name": "Resultados e manuscrito",
      "role": "analyst",
      "closes_with": "05_synthesis/manuscript.md",
      "producer_tools": [],
      "active": true
    }
  ],
  "invariants_always_on": [
    "RV-01",
    "RV-02",
    "RV-03",
    "RV-04",
    "RV-05",
    "RV-06",
    "RV-07",
    "RV-08"
  ],
  "gates": [
    {
      "phase": "F1",
      "rule": "RV-01",
      "tool": "submit_protocol_for_approval",
      "blocks": "spawn do librarian se protocolo não estiver [LOCKED]"
    },
    {
      "phase": "F4",
      "rule": "RV-02",
      "tool": "compute_flow_counts",
      "blocks": "contagens manuais"
    },
    {
      "phase": "F8",
      "rule": "RV-05",
      "tool": "validate_prisma_flow",
      "blocks": "export se o funil não fechar"
    },
    {
      "phase": "F8",
      "rule": "RV-08",
      "tool": "audit_methodology",
      "blocks": "síntese se estudo sem origem"
    }
  ],
  "required_supplements": [
    "prisma_scr_checklist_filled.md",
    "prisma_s_checklist_filled.md",
    "supplement_search_prisma_s.md",
    "supplement_sources_registry.md",
    "dedupe_report.md",
    "screening_report.md",
    "study_characteristics_table.csv",
    "prisma_flow_counts.md",
    "manuscript_prisma_revised.md",
    "change_log.md",
    "audit_summary.md"
  ],
  "project_folders": [
    "01_raw",
    "02_deduplicated",
    "03_screening",
    "03_screening/pdfs",
    "04_extraction",
    "05_synthesis",
    "logs",
    "rag"
  ]
}
